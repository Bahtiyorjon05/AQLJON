# Copy to .env and fill in real values. NEVER commit the real .env.
# On Heroku these are set with:  heroku config:set KEY=value -a aqljon

# ─── Required ──────────────────────────────────────────────────
# From @BotFather. If this ever leaks, run /revoke in @BotFather immediately.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ─── Optional ──────────────────────────────────────────────────
# Extra free-tier Gemini keys, comma-separated. The bot automatically
# rotates to the next key when one hits its daily quota, so N keys give
# roughly N times the free daily budget. Create each key under a
# different Google account — keys in one account share a single quota.
GEMINI_API_KEYS=YOUR_SECOND_KEY,YOUR_THIRD_KEY

GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MODEL_FALLBACK=gemini-2.5-flash

# Your Telegram user ID — unlocks /adminstats, /broadcast, /monitor, /reply
ADMIN_ID=YOUR_TELEGRAM_USER_ID

# From https://serper.dev — enables /search
SERPER_API_KEY=YOUR_SERPER_API_KEY

# Firebase service-account JSON as a single line — enables persistent storage.
# Without it the bot runs in memory-only mode and loses data on restart.
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}
